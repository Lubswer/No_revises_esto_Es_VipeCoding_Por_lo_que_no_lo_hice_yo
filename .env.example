# ============================================
# Agente de Memoria de Aprendizaje Personal
# Groq + Mem0 + Notion
# ============================================

# Groq — Modelo LLM gratuito (https://console.groq.com/)
GROQ_API_KEY=

# Mem0 — Memoria semántica (https://app.mem0.ai/)
MEM0_API_KEY=

# Notion — Base de conocimiento (https://www.notion.so/my-integrations)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Configuración del usuario (para Mem0)
USER_ID=usuario_principal

# Servidor (modo --serve)
PORT=3000
